# Dependencies
node_modules/
package-lock.json

# System files
.DS_Store
Thumbs.db
Desktop.ini
*.tmp

# Editors
.vscode/
.idea/
*.swp
*.swo
*~

# Environment
.env
.env.local
.env.*.local

# Python (dev scripts)
__pycache__/
*.pyc
*.pyo
bge_env/
mineru_env/

# Build/test artifacts
playwright-report/
test-results/
tmp/

# 高考原始数据（sdzk.cn 官方 XLS，约 12MB，不入库；构建脚本可 --download 重新获取）
# 但 site/*.json 是各校官网手工整理的唯一源数据，体积小且无法自动重抓，必须入库
scripts/data/gaokao/*
!scripts/data/gaokao/site/
scripts/data/gaokao/site/*
!scripts/data/gaokao/site/*.json

# Logs
*.log

# AI 工作区（本地记忆与临时文件，不入库）
.workbuddy/

# QDII 指数页抓取缓存（可由 scripts/build_qdii_data.py --refresh 重建）
scripts/data/qdii/*
